<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#141E2C" />
            <stroke
                android:width="1.5dp"
                android:color="#24374D" />
        </shape>
    </item>
    <!-- Inner Dark Glass Gradient -->
    <item
        android:top="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="24.5dp" />
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#1E2B3E"
                android:endColor="#121A26" />
        </shape>
    </item>
</layer-list>

