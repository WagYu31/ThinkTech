<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 3D Inset Groove Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="#001826" />
        </shape>
    </item>
    <!-- Neon Diffusion Glow -->
    <item
        android:top="1dp"
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#9900F2FE" />
        </shape>
    </item>
    <!-- Hot Core Light Tube -->
    <item
        android:top="1dp"
        android:bottom="1dp"
        android:left="5dp"
        android:right="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
