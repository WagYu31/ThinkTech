<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Deep 3D Ambient Drop Shadow (Floor Depth) -->
    <item
        android:top="10dp"
        android:left="2dp"
        android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#B3000000" />
        </shape>
    </item>

    <!-- 2. Dark Cavity Inset Base (Recessed Socket Rim) -->
    <item
        android:top="2dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#070C13" />
        </shape>
    </item>

    <!-- 3. Physical 3D Extrusion Side Wall (Titanium Bevel Lip) -->
    <item
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#263447"
                android:endColor="#0B111A" />
            <stroke
                android:width="1dp"
                android:color="#243447" />
        </shape>
    </item>

    <!-- 4. Front Raised 3D Rocker Paddle Face -->
    <item
        android:bottom="8dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#2B3C52"
                android:centerColor="#1B2737"
                android:endColor="#0F1722" />
            <stroke
                android:width="1.5dp"
                android:color="#3B4F67" />
        </shape>
    </item>

    <!-- 5. Top 3D Specular Light Glare Reflection -->
    <item
        android:top="4dp"
        android:left="20dp"
        android:right="20dp"
        android:height="2.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="1dp" />
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#40FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
