<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer sculpted pearl ring -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#F6F8FB"
                android:endColor="#ECEFF5"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#E4E8F0" />
        </shape>
    </item>
    <!-- Delicate inner bevel highlight -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#B3FFFFFF" />
        </shape>
    </item>
</layer-list>
