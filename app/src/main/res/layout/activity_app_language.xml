<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <!-- 1. EDITORIAL TOP BAR -->
    <RelativeLayout
        android:id="@+id/topBarLanguage"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="14dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackLanguage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kembali"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left"
            app:tint="#151922" />

        <TextView
            android:id="@+id/tvLanguageHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:letterSpacing="-0.02"
            android:text="Bahasa Aplikasi"
            android:textColor="#151922"
            android:textSize="18sp" />
    </RelativeLayout>

    <!-- 2. SCROLLABLE CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/footerLanguageApply"
        app:layout_constraintTop_toBottomOf="@id/topBarLanguage">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="20dp">

            <!-- LIVE BILINGUAL & VOICE AI PREVIEW CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_lang_hero_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_smart_white_circle"
                        android:elevation="1dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_app_language" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPreviewVoiceBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:text="Teks &amp; Voice AI (id-ID)"
                            android:textColor="#3B5BFF"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvPreviewGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:letterSpacing="-0.02"
                            android:text="Halo, Selamat Datang"
                            android:textColor="#151922"
                            android:textSize="18sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPreviewVoiceQuote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_smart_card_white_22"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:text="“Nyalakan semua lampu di seluruh ruangan”"
                    android:textColor="#4B5563"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- SEARCH LANGUAGE PILL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_smart_card_white_22"
                android:elevation="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_lang_search" />

                <EditText
                    android:id="@+id/etSearchLanguage"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/plus_jakarta_sans_regular"
                    android:hint="Cari bahasa..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="#151922"
                    android:textColorHint="#9AA1AE"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- SECTION HEADER -->
            <TextView
                android:id="@+id/tvLanguageSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="Pilih Bahasa"
                android:textColor="#6B7280"
                android:textSize="12.5sp" />

            <!-- SCULPTED WHITE LANGUAGE LIST CARD -->
            <LinearLayout
                android:id="@+id/layoutLanguageList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_smart_card_white_22"
                android:elevation="1dp"
                android:orientation="vertical"
                android:paddingVertical="4dp" />

            <!-- FOOTNOTE -->
            <TextView
                android:id="@+id/tvLanguageNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Perubahan bahasa langsung diterapkan ke seluruh halaman dan Asisten Suara (Voice AI)."
                android:textColor="#7D8596"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 3. STICKY WHITE FOOTER WITH ROYAL-BLUE APPLY BUTTON -->
    <LinearLayout
        android:id="@+id/footerLanguageApply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/btnApplyLanguage"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_smart_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:gravity="center"
            android:text="Terapkan Bahasa"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
