<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootConnecting"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <!-- ========================================================== -->
    <!-- STATE 1: CONNECTING PROGRESS RING (27_Light_ad / 31_Light) -->
    <!-- ========================================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutConnectingState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:paddingBottom="24dp"
        android:visibility="visible">

        <!-- Top Navigation Bar -->
        <RelativeLayout
            android:id="@+id/topBarConnecting"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Kembali"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/harmony_ink" />

            <TextView
                android:id="@+id/tvTopBarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:letterSpacing="-0.02"
                android:text="Add Device"
                android:textColor="@color/harmony_ink"
                android:textSize="18sp" />

            <ImageButton
                android:id="@+id/btnMoreConnecting"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Opsi"
                android:src="@drawable/ic_more_dots"
                app:tint="@color/harmony_ink" />
        </RelativeLayout>

        <!-- Heading: Connect to device -->
        <TextView
            android:id="@+id/tvConnectingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:gravity="center"
            android:letterSpacing="-0.02"
            android:text="Connect to device"
            android:textColor="@color/harmony_ink"
            android:textSize="21sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBarConnecting" />

        <!-- Wi-Fi & Bluetooth Pill -->
        <LinearLayout
            android:id="@+id/layoutConnWifiBtPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pair_info_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvConnectingTitle">

            <FrameLayout
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/bg_hyperos_status_dot"
                android:backgroundTint="#3858FF">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_input_wifi"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_hyperos_status_dot"
                android:backgroundTint="#3858FF">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_bluetooth_clean"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvConnectingSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:text="Turn on your Wifi &amp; Bluetooth to connect"
                android:textColor="@color/harmony_ink_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Selected Device Name Badge (Blue Check + Device Name) -->
        <LinearLayout
            android:id="@+id/layoutDeviceBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutConnWifiBtPill">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_connect_check_small" />

            <TextView
                android:id="@+id/tvConnectingDeviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:maxLines="1"
                android:text="WiFi 3ch switch"
                android:textColor="@color/harmony_ink"
                android:textSize="14.5sp" />
        </LinearLayout>

        <!-- Center Animated Circular Progress Ring + Hero Device Image -->
        <FrameLayout
            android:id="@+id/flProgressRingContainer"
            android:layout_width="256dp"
            android:layout_height="256dp"
            app:layout_constraintBottom_toTopOf="@id/layoutProgressReadout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutDeviceBadge"
            app:layout_constraintVertical_bias="0.46">

            <com.thinktech.smarthome.ui.pairing.HarmonyConnectRingView
                android:id="@+id/connectRingView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/ivConnectingDeviceIcon"
                android:layout_width="138dp"
                android:layout_height="138dp"
                android:layout_gravity="center"
                android:contentDescription="Perangkat"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_tuya_wifi_3ch_switch" />
        </FrameLayout>

        <!-- Live Progress Readout ("Connecting..." + "75%" + step hint) -->
        <LinearLayout
            android:id="@+id/layoutProgressReadout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            app:layout_constraintBottom_toTopOf="@id/layoutRetryActions">

            <TextView
                android:id="@+id/tvConnectingStatusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:text="Connecting..."
                android:textColor="@color/harmony_ink_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvConnectingPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:letterSpacing="-0.02"
                android:text="0%"
                android:textColor="#3858FF"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/tvConnectingStepDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:gravity="center"
                android:maxLines="2"
                android:text="Menyiapkan koneksi aman ke perangkat..."
                android:textColor="@color/harmony_ink_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Manual Connect / Error Retry Actions (Hidden while actively connecting) -->
        <LinearLayout
            android:id="@+id/layoutRetryActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/layoutConnectingFooter">

            <TextView
                android:id="@+id/btnChangeWifi"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_connect_secondary_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:gravity="center"
                android:text="Ubah Wi-Fi"
                android:textColor="#3858FF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnRetryOrConnect"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pair_connect_btn"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:gravity="center"
                android:text="Connect"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Footer: Can't connect with your devices? Learn more -->
        <LinearLayout
            android:id="@+id/layoutConnectingFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:text="Can't connect with your devices?"
                android:textColor="@color/harmony_ink_muted"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/tvLearnMoreConnecting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="Learn more"
                android:textColor="#3858FF"
                android:textSize="12.5sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ========================================================== -->
    <!-- STATE 2: CONNECTED! SUCCESS CELEBRATION (28_Light_ad)      -->
    <!-- ========================================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutConnectedState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:paddingHorizontal="22dp"
        android:paddingBottom="28dp"
        android:visibility="gone">

        <!-- Success Check + Title + Subtitle -->
        <LinearLayout
            android:id="@+id/layoutConnectedHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="72dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivConnectedCheck"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="Connected"
                android:src="@drawable/ic_connect_success_check" />

            <TextView
                android:id="@+id/tvConnectedTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:letterSpacing="-0.02"
                android:text="Connected!"
                android:textColor="@color/harmony_ink"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tvConnectedSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:gravity="center"
                android:text="You have connected to WiFi 3ch switch"
                android:textColor="@color/harmony_ink_secondary"
                android:textSize="13.5sp" />
        </LinearLayout>

        <!-- Large Centered Hero Device Showcase -->
        <FrameLayout
            android:id="@+id/flConnectedDeviceShowcase"
            android:layout_width="210dp"
            android:layout_height="210dp"
            app:layout_constraintBottom_toTopOf="@id/layoutConnectedActions"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutConnectedHeader">

            <ImageView
                android:id="@+id/ivConnectedDeviceIcon"
                android:layout_width="172dp"
                android:layout_height="172dp"
                android:layout_gravity="center"
                android:contentDescription="Perangkat Terhubung"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_tuya_wifi_3ch_switch" />
        </FrameLayout>

        <!-- Bottom Dual Pill CTAs: Go to Homepage | Control Device -->
        <LinearLayout
            android:id="@+id/layoutConnectedActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/btnGoToHomepage"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:background="@drawable/bg_connect_secondary_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:gravity="center"
                android:text="Go to Homepage"
                android:textColor="#3858FF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnControlDevice"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pair_connect_btn"
                android:clickable="true"
                android:elevation="3dp"
                android:focusable="true"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:gravity="center"
                android:text="Control Device"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
