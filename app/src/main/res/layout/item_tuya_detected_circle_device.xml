<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llDetectedRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackgroundBorderless">

    <!-- Outer Circular Ripple Ring -->
    <FrameLayout
        android:id="@+id/flRippleRing"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:background="@drawable/bg_tuya_device_ripple_ring">

        <!-- Inner Rounded Square Tile -->
        <FrameLayout
            android:id="@+id/flDeviceTile"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_tuya_device_tile">

            <ImageView
                android:id="@+id/ivDetectedIcon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_tuya_wifi_3ch_switch" />
        </FrameLayout>
    </FrameLayout>

    <!-- Device Name below icon -->
    <TextView
        android:id="@+id/tvDetectedName"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="WiFi 3ch\nswitch"
        android:textColor="#1E293B"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end" />

</LinearLayout>
