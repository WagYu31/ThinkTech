<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <!-- 1. MINIMALIST TOP BAR -->
    <RelativeLayout
        android:id="@+id/topBarSchedule"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="14dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackSchedule"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kembali"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left"
            app:tint="#151922" />

        <TextView
            android:id="@+id/tvScheduleHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:letterSpacing="-0.02"
            android:text="Atur Waktu Jadwal"
            android:textColor="#151922"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/btnDeleteSchedule"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Hapus Jadwal"
            android:padding="8dp"
            android:src="@drawable/ic_schedule_trash"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- 2. SCROLLABLE STUDIO CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/footerScheduleCta"
        app:layout_constraintTop_toBottomOf="@id/topBarSchedule">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="18dp">

            <!-- CARD 1: REPEAT + DIGITAL TIME + 24H RADIAL ANALOG CLOCK -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_smart_card_white_22"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Repeat Row -->
                <LinearLayout
                    android:id="@+id/rowRepeatSelector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_schedule_repeat" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:text="Ulangi"
                        android:textColor="#151922"
                        android:textSize="14.5sp" />

                    <TextView
                        android:id="@+id/tvRepeatSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_medium"
                        android:text="Setiap Hari"
                        android:textColor="#646C7C"
                        android:textSize="13.5sp" />

                    <ImageView
                        android:id="@+id/ivRepeatChevron"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="4dp"
                        android:rotation="180"
                        android:src="@drawable/ic_chevron_left"
                        app:tint="#9AA1AE" />
                </LinearLayout>

                <!-- Expandable 7-Day Repeat Pills -->
                <LinearLayout
                    android:id="@+id/layoutRepeatDays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/daySun"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/bg_smart_day_active"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:gravity="center"
                            android:text="M"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/dayMon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/bg_smart_day_active"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:gravity="center"
                            android:text="S"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/dayTue"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/bg_smart_day_active"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:gravity="center"
                            android:text="S"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/dayWed"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/bg_smart_day_active"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:gravity="center"
                            android:text="R"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/dayThu"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/bg_smart_day_active"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:gravity="center"
                            android:text="K"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/dayFri"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/bg_smart_day_active"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:gravity="center"
                            android:text="J"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/daySat"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/bg_smart_day_active"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:gravity="center"
                            android:text="S"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnRepeatDaily"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_lamp_tab_track"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/plus_jakarta_sans_semibold"
                            android:gravity="center"
                            android:text="Setiap Hari"
                            android:textColor="#3B5BFF"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/btnRepeatWorkdays"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_lamp_tab_track"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/plus_jakarta_sans_semibold"
                            android:gravity="center"
                            android:text="Hari Kerja"
                            android:textColor="#2A303D"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/btnRepeatOnce"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_lamp_tab_track"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/plus_jakarta_sans_semibold"
                            android:gravity="center"
                            android:text="Sekali Saja"
                            android:textColor="#2A303D"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="#F0F2F7" />

                <!-- Giant Tabular Hour : Minute Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_lamp_tab_track"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvClockHour"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="21"
                        android:textColor="#141820"
                        android:textSize="32sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text=":"
                        android:textColor="#9AA2B1"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/tvClockMinute"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="45"
                        android:textColor="#9AA2B1"
                        android:textSize="32sp" />
                </LinearLayout>

                <!-- Interactive 24-Hour & Minute Radial Analog Clock -->
                <com.thinktech.smarthome.ui.schedule.HarmonyRadialClockView
                    android:id="@+id/radialClockView"
                    android:layout_width="268dp"
                    android:layout_height="268dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="18dp" />
            </LinearLayout>

            <!-- CARD 2: TARGET DEVICE, CHANNEL & ACTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_smart_card_white_22"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Target Device Selector -->
                <LinearLayout
                    android:id="@+id/rowTargetDevice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:text="Perangkat Target"
                        android:textColor="#151922"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvTargetDeviceName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:text="Semua Saklar"
                        android:textColor="#3B5BFF"
                        android:textSize="13.5sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="4dp"
                        android:rotation="180"
                        android:src="@drawable/ic_chevron_left"
                        app:tint="#9AA1AE" />
                </LinearLayout>

                <!-- Optional Channel Row (for Multi-Gang Switch) -->
                <LinearLayout
                    android:id="@+id/layoutChannelRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/chipChAll"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_lamp_tab_active"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:gravity="center"
                        android:text="Semua"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chipCh1"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_lamp_tab_track"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:gravity="center"
                        android:text="L1"
                        android:textColor="#2A303D"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chipCh2"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_lamp_tab_track"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:gravity="center"
                        android:text="L2"
                        android:textColor="#2A303D"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chipCh3"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_lamp_tab_track"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:gravity="center"
                        android:text="L3"
                        android:textColor="#2A303D"
                        android:textSize="12sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#F0F2F7" />

                <!-- Action Segmented Toggle (ON / OFF) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_lamp_tab_track"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/btnActionTurnOn"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_lamp_tab_active"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:gravity="center"
                        android:text="Nyalakan (ON)"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btnActionTurnOff"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:gravity="center"
                        android:text="Matikan (OFF)"
                        android:textColor="#2A303D"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 3. STICKY WHITE FOOTER WITH ROYAL-BLUE CONTINUE / SAVE CTA -->
    <LinearLayout
        android:id="@+id/footerScheduleCta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/btnSaveSchedule"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_smart_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:gravity="center"
            android:text="Simpan Jadwal"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
