<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_thinktech_login_backdrop">

    <!-- ================= 1. WELCOME LANDING SCREEN ================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutWelcome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_thinktech_login_backdrop"
        android:visibility="visible">

        <!-- Center Branded Hero Container (Clean, Minimalist & Focused) -->
        <LinearLayout
            android:id="@+id/centerHeroContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            app:layout_constraintBottom_toTopOf="@+id/bottomActionsContainer"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.45">

            <!-- 3D Glass Badge with Ambient Halo Glow -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <ImageView
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center"
                    android:src="@drawable/bg_ambient_hero_glow" />

                <ImageView
                    android:id="@+id/ivTuyaLogo"
                    android:layout_width="116dp"
                    android:layout_height="116dp"
                    android:layout_gravity="center"
                    android:contentDescription="ThinkTech"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_thinktech_3d_glass_badge" />
            </FrameLayout>

            <!-- Brand Typography -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="-0.03"
                android:text="ThinkTech"
                android:textColor="@color/thinktech_dark"
                android:textSize="34sp"
                android:textStyle="bold" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.01"
                android:text="Intelligent Living, Effortlessly Unified."
                android:textColor="@color/thinktech_slate"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Bottom Action Buttons Container (21st.dev Style CTAs) -->
        <LinearLayout
            android:id="@+id/bottomActionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="32dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Primary CTA: Sign In -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnWelcomeLogin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/btn_thinktech_primary"
                android:drawableEnd="@drawable/ic_arrow_right_c"
                android:drawablePadding="10dp"
                android:elevation="4dp"
                android:letterSpacing="0.01"
                android:paddingStart="24dp"
                android:paddingEnd="20dp"
                android:text="Sign In with Existing Account"
                android:textAllCaps="false"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Secondary CTA: Create Account -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnWelcomeRegister"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_thinktech_secondary"
                android:elevation="1dp"
                android:letterSpacing="0.01"
                android:text="Create Account"
                android:textAllCaps="false"
                android:textColor="@color/thinktech_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Tertiary CTA: Explore as Guest -->
            <TextView
                android:id="@+id/tvTryAsGuest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_pill_guest_btn"
                android:paddingStart="20dp"
                android:paddingTop="9dp"
                android:paddingEnd="20dp"
                android:paddingBottom="9dp"
                android:text="Explore as Guest →"
                android:textColor="#475569"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <!-- Security & Trust Footnote -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_lock_tiny" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:letterSpacing="0.02"
                    android:text="256-Bit SSL Encrypted • Powered by Tuya IoT Global"
                    android:textColor="@color/thinktech_slate_light"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ================= 2. SIGN IN SCREEN ================= -->
    <ScrollView
        android:id="@+id/layoutLoginForm"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_thinktech_login_backdrop"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="52dp"
            android:paddingEnd="24dp"
            android:paddingBottom="40dp">

            <!-- Top Bar: Back Arrow & Quick Switch to Sign Up -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <ImageButton
                    android:id="@+id/btnBackFromLogin"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/thinktech_dark" />

                <TextView
                    android:id="@+id/tvSwitchToRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="8dp"
                    android:text="Sign Up"
                    android:textColor="@color/thinktech_blue"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Title & Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:letterSpacing="-0.02"
                android:text="Sign In"
                android:textColor="@color/thinktech_dark"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Welcome back! Please enter your account details."
                android:textColor="@color/thinktech_slate"
                android:textSize="14sp" />

            <!-- Row 1: Account Input (Email / Phone) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/selector_input_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_input_email"
                    app:tint="@color/thinktech_slate" />

                <EditText
                    android:id="@+id/etLoginAccount"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:autofillHints="username,emailAddress,phoneNumber"
                    android:background="@null"
                    android:hint="Email address or phone number"
                    android:importantForAutofill="yes"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/thinktech_dark"
                    android:textColorHint="@color/thinktech_slate_light"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Row 3: Password Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/selector_input_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_input_lock"
                    app:tint="@color/thinktech_slate" />

                <EditText
                    android:id="@+id/etLoginPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:autofillHints="password"
                    android:background="@null"
                    android:hint="Password"
                    android:importantForAutofill="yes"
                    android:inputType="textPassword"
                    android:textColor="@color/thinktech_dark"
                    android:textColorHint="@color/thinktech_slate_light"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/ivLoginTogglePassword"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Toggle password"
                    android:padding="10dp"
                    android:src="@drawable/ic_visibility_off"
                    app:tint="@color/thinktech_slate" />
            </LinearLayout>

            <!-- Options Row: Remember Me & Forgot Password -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <!-- Remember Me Checkbox -->
                <LinearLayout
                    android:id="@+id/layoutRememberMe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp"
                    android:paddingEnd="8dp">

                    <androidx.appcompat.widget.AppCompatCheckBox
                        android:id="@+id/cbRememberMe"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:background="@null"
                        android:button="@drawable/sl_custom_checkbox"
                        app:buttonCompat="@drawable/sl_custom_checkbox"
                        android:buttonTint="@null"
                        app:buttonTint="@null"
                        android:checked="true"
                        android:clickable="false"
                        android:focusable="false" />

                    <TextView
                        android:id="@+id/tvRememberMe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Remember me"
                        android:textColor="@color/thinktech_slate"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Forgot Password Link -->
                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:paddingVertical="4dp"
                    android:paddingStart="6dp"
                    android:text="Forgot password?"
                    android:textColor="@color/thinktech_blue"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Error Banner -->
            <TextView
                android:id="@+id/tvLoginError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/status_red"
                android:textSize="13sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Agreement Section -->
            <LinearLayout
                android:id="@+id/layoutLoginAgreement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp"
                android:paddingHorizontal="2dp">

                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/cbLoginAgreement"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:background="@null"
                    android:button="@drawable/sl_custom_checkbox"
                    app:buttonCompat="@drawable/sl_custom_checkbox"
                    android:buttonTint="@null"
                    app:buttonTint="@null"
                    android:checked="true" />

                <TextView
                    android:id="@+id/tvLoginAgreement"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="I agree to the Terms of Service and Privacy Policy"
                    android:textColor="@color/thinktech_slate"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- Primary Submit Button: Sign In -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLoginSubmit"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_thinktech_primary"
                android:elevation="4dp"
                android:text="Sign In"
                android:textAllCaps="false"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressLogin"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/thinktech_blue"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- ================= 3. SIGN UP (REGISTER) SCREEN ================= -->
    <ScrollView
        android:id="@+id/layoutRegisterForm"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_thinktech_login_backdrop"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="52dp"
            android:paddingEnd="24dp"
            android:paddingBottom="40dp">

            <!-- Top Bar: Back Arrow & Quick Switch to Sign In -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <ImageButton
                    android:id="@+id/btnBackFromRegister"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/thinktech_dark" />

                <TextView
                    android:id="@+id/tvSwitchToLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="8dp"
                    android:text="Sign In"
                    android:textColor="@color/thinktech_blue"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Title & Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:letterSpacing="-0.02"
                android:text="Create Account"
                android:textColor="@color/thinktech_dark"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Connect and automate all your smart home devices seamlessly."
                android:textColor="@color/thinktech_slate"
                android:textSize="14sp" />

            <!-- Row 1: Full Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/selector_input_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_input_person"
                    app:tint="@color/thinktech_slate" />

                <EditText
                    android:id="@+id/etRegisterName"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:background="@null"
                    android:hint="Full Name"
                    android:inputType="textPersonName"
                    android:textColor="@color/thinktech_dark"
                    android:textColorHint="@color/thinktech_slate_light"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRegisterNameError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:textColor="@color/status_red"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Row 3: Phone Number with Country Code & Flag Picker -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/selector_input_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="16dp">

                <!-- Interactive Country Code + Flag Chip -->
                <LinearLayout
                    android:id="@+id/btnRegisterCountryPicker"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_country_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/tvRegisterCountryFlag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="🇮🇩"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvRegisterCountryCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="+62"
                        android:textColor="@color/thinktech_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/thinktech_slate" />
                </LinearLayout>

                <!-- Vertical Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="#E2E8F0" />

                <!-- Phone Input Field -->
                <EditText
                    android:id="@+id/etRegisterPhone"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="812-3456-7890"
                    android:inputType="phone"
                    android:maxLength="18"
                    android:textColor="@color/thinktech_dark"
                    android:textColorHint="@color/thinktech_slate_light"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Live Phone Status Indicator -->
            <TextView
                android:id="@+id/tvRegisterPhoneStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:textColor="@color/thinktech_slate"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Row 4: Email Address -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/selector_input_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_input_email"
                    app:tint="@color/thinktech_slate" />

                <EditText
                    android:id="@+id/etRegisterEmail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:autofillHints="emailAddress,username"
                    android:background="@null"
                    android:hint="Email address"
                    android:importantForAutofill="yes"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/thinktech_dark"
                    android:textColorHint="@color/thinktech_slate_light"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Live Email Status Indicator -->
            <TextView
                android:id="@+id/tvRegisterEmailStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:textColor="@color/thinktech_slate"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Row 5: Password -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/selector_input_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_input_lock"
                    app:tint="@color/thinktech_slate" />

                <EditText
                    android:id="@+id/etRegisterPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:autofillHints="newPassword"
                    android:background="@null"
                    android:hint="Create password"
                    android:importantForAutofill="yes"
                    android:inputType="textPassword"
                    android:textColor="@color/thinktech_dark"
                    android:textColorHint="@color/thinktech_slate_light"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/ivRegisterTogglePassword"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Toggle password"
                    android:padding="10dp"
                    android:src="@drawable/ic_visibility_off"
                    app:tint="@color/thinktech_slate" />
            </LinearLayout>

            <!-- Real-Time Password Requirements Checklist Card -->
            <LinearLayout
                android:id="@+id/layoutPasswordRules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pill_feature_tag"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Rule 1: 8+ characters -->
                <LinearLayout
                    android:id="@+id/rowRuleLength"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivRuleLength"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_rule_uncheck" />

                    <TextView
                        android:id="@+id/tvRuleLength"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="At least 8 characters"
                        android:textColor="@color/thinktech_slate"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Rule 2: 1 symbol -->
                <LinearLayout
                    android:id="@+id/rowRuleSymbol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivRuleSymbol"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_rule_uncheck" />

                    <TextView
                        android:id="@+id/tvRuleSymbol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="At least 1 symbol (@, #, $, %, !, etc.)"
                        android:textColor="@color/thinktech_slate"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Error Banner -->
            <TextView
                android:id="@+id/tvRegisterError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/status_red"
                android:textSize="13sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Agreement Section -->
            <LinearLayout
                android:id="@+id/layoutRegisterAgreement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp"
                android:paddingHorizontal="2dp">

                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/cbRegisterAgreement"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:background="@null"
                    android:button="@drawable/sl_custom_checkbox"
                    app:buttonCompat="@drawable/sl_custom_checkbox"
                    android:buttonTint="@null"
                    app:buttonTint="@null"
                    android:checked="true" />

                <TextView
                    android:id="@+id/tvRegisterAgreement"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="I agree to the Terms of Service and Privacy Policy"
                    android:textColor="@color/thinktech_slate"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- Primary Button: Create Account -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRegisterSubmit"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_thinktech_primary"
                android:elevation="4dp"
                android:text="Create Account"
                android:textAllCaps="false"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressRegister"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/thinktech_blue"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
